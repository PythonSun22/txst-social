DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Server-side OpenAI credential for backend/moderation.py. Never commit a real key.
OPENAI_API_KEY=

# Apply the automatic_post_moderation migration before enabling this worker.
# Enable only after this migration is applied to the configured database.
MODERATION_ENABLED=false
MODERATION_MAX_ATTEMPTS=3
MODERATION_RETRY_SECONDS=30
MODERATION_POLL_SECONDS=2
# Experimental local text-only recheck; keep off in shared environments.
MODERATION_CONTEXT_RECHECK_ENABLED=false
# Backend only. Needed to screen pending private images without the author's session.
# Use a Supabase secret key, or set SUPABASE_SERVICE_ROLE_KEY for a legacy service_role key.
SUPABASE_SECRET_KEY=

# Apply 20261022072231_image_variants.sql first. Requires the backend Storage
# secret above and OPENAI_API_KEY. One processing job at a time per API process.
IMAGE_PROCESSING_ENABLED=false
IMAGE_PROCESSING_MAX_ATTEMPTS=3
IMAGE_PROCESSING_RETRY_SECONDS=30
IMAGE_PROCESSING_POLL_SECONDS=2
